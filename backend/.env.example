AI_PROVIDER=ollama
AI_AUTO_ORDER=ollama
OLLAMA_ENABLED=true
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_NUM_CTX=8192
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_REQUEST_TIMEOUT_SECONDS=300
COMMAND_TIMEOUT_SECONDS=180

SECRET_KEY=generate-a-long-random-secret
AGENT_PAIRING_TOKEN=generate-a-long-random-token
VOICE_API_TOKEN=generate-a-long-random-token
# For a single-user local installation this can be left blank; JARVIS will use the only account.
# For multi-user use, set it to the dashboard account email that should own iPhone voice history.
VOICE_USER_EMAIL=
ORCHESTRATION_MAX_WORKERS=6

DESKTOP_CONTROL_ENABLED=true
JARVIS_ENV=development
ENABLE_DOCS=true
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
TRUSTED_HOSTS=127.0.0.1,localhost
