SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///../data/jarvis.db
WORKSPACE_PATH=../workspace

# V9 AI: local Ollama only
AI_PROVIDER=ollama
AI_AUTO_ORDER=ollama
AI_REQUEST_TIMEOUT_SECONDS=300
COMMAND_TIMEOUT_SECONDS=180
OLLAMA_ENABLED=true
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_NUM_CTX=8192
OLLAMA_BASE_URL=http://127.0.0.1:11434

CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
AGENT_PAIRING_TOKEN=generate-a-long-random-token
AGENT_ID=local-laptop
VOICE_API_TOKEN=generate-a-long-random-voice-token
DESKTOP_CONTROL_ENABLED=true
DESKTOP_ACTION_TIMEOUT_SECONDS=30

# V6 desktop voice
JARVIS_SERVER=http://127.0.0.1:8000
JARVIS_VOICE_TOKEN=use-the-same-VOICE_API_TOKEN
JARVIS_WAKE_PHRASE=hey jarvis
JARVIS_HOTKEY=ctrl+alt+j
JARVIS_STT_LANGUAGE=en-IN
JARVIS_TTS_RATE=175
JARVIS_VOSK_MODEL=
JARVIS_OFFLINE_ONLY=false

# V8 production hardening
JARVIS_ENV=development
ENABLE_DOCS=true
TRUSTED_HOSTS=127.0.0.1,localhost

# Optional: attach iPhone/voice conversations to this dashboard account.
VOICE_USER_EMAIL=
ORCHESTRATION_MAX_WORKERS=6
