JARVIS_ENV=production
ENABLE_DOCS=false
TRUSTED_HOSTS=127.0.0.1,localhost,YOUR-PC-IP
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
DATABASE_URL=sqlite:///../data/jarvis.db
WORKSPACE_PATH=../workspace

# V9 AI: local Ollama only
AI_PROVIDER=ollama
AI_AUTO_ORDER=ollama
AI_REQUEST_TIMEOUT_SECONDS=300
COMMAND_TIMEOUT_SECONDS=180
OLLAMA_ENABLED=true
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_NUM_CTX=8192
OLLAMA_BASE_URL=http://127.0.0.1:11434

CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
AGENT_PAIRING_TOKEN=REPLACE_WITH_RANDOM_AGENT_TOKEN
AGENT_ID=local-laptop
VOICE_API_TOKEN=REPLACE_WITH_RANDOM_VOICE_TOKEN
DESKTOP_CONTROL_ENABLED=true
DESKTOP_ACTION_TIMEOUT_SECONDS=30

# Optional: attach iPhone/voice conversations to this dashboard account.
VOICE_USER_EMAIL=
ORCHESTRATION_MAX_WORKERS=6
